"Name"     = 'Bloco de variável'
"Author"   = 'José Gabriel Gomes'
"Version"  = '0.1'
"About"    = 'Bloco de variável para inteiro, real, string e booleano'

"Start Symbol" = <CONSTS_BLOCK>

! -------------------------------------------------
! Character Sets
! -------------------------------------------------
! Welcome to GOLD Parser Builder 5.2


! -------------------------------------------------
! Terminals
! -------------------------------------------------

Integer = {Number}+
        
Decimal = {Number}+ '.' {Number}+

IDE = {Letter} ({Letter} | {Number} | '_')*

{String Chars} = {Printable} - {NBSP} - ["]
StringLiteral = '"' {String Chars}* '"'
               
! -------------------------------------------------
! Rules
! -------------------------------------------------

! The grammar starts below         
<CONSTS_BLOCK> ::=  'const' '{' <CONSTS_BODY>
<CONSTS_BODY> ::= '}' | <CONSTS> '}'
<CONSTS> ::= <CONST> | <CONST> <CONSTS>
<CONST> ::= <TYPE> IDE '=' <ATRIBUITION> <MULTIPLE_CONSTS> ';'
<MULTIPLE_CONSTS> ::= | ',' IDE '=' <ATRIBUITION> <MULTIPLE_CONSTS> 
<ATRIBUITION> ::= Integer | Decimal | 'true' | 'false' | <CAC>        
<TYPE> ::= 'int' | 'real' | 'boolean' | 'string'
<CAC> ::= StringLiteral


